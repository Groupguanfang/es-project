{
  "name": "{{name}}",
  "type": "module",
  "version": "0.0.1",
  "description": "{{description}}",
  "author": "Naily Zero <zero@naily.cc> (https://naily.cc)",
  "keywords": [
    "es-project-template"
  ],
  "exports": {
    {{#each (split entry) as |file|}}
    "./{{file}}": {
      "types": "./dist/{{file}}.d.ts",
      "import": "./dist/{{file}}.js",
      "require": "./dist/{{file}}.cjs"
    }{{#unless @last}},{{/unless}}
    {{/each}}
  },
  "main": "./dist/{{#with (split entry) as |items|}}{{items.[0]}}{{/with}}.cjs",
  "module": "./dist/{{#with (split entry) as |items|}}{{items.[0]}}{{/with}}.js",
  "types": "./dist/{{#with (split entry) as |items|}}{{items.[0]}}{{/with}}.d.ts",
  "scripts": {
    "build": "tsup",
    "watch": "tsup -w"
  },
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "tsup": "^8.3.0"
  }
}
