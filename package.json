{
  "name": "@es-project-template/antfu-lib-monorepo",
  "type": "module",
  "version": "0.0.1",
  "description": "Create a lib monorepo with antfu's code style",
  "author": "Naily Zero <zero@naily.cc> (https://naily.cc)",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "new": "cross-env IS_IN_ES_PROJECT=true tsx ./templates/father/test/internal.ts new",
    "build": "pnpm -F es-project build",
    "lint": "eslint .",
    "postinstall": "npx simple-git-hooks",
    "test": "vitest --ui --coverage",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^3.7.3",
    "@changesets/cli": "^2.27.11",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22.7.5",
    "@vitest/coverage-v8": "2.1.8",
    "@vitest/ui": "2.1.8",
    "bumpp": "^9.7.1",
    "cross-env": "^7.0.3",
    "eslint": "^9.12.0",
    "fast-glob": "^3.3.2",
    "js-yaml": "^4.1.0",
    "lint-staged": "^15.2.10",
    "pnpm": "^9.15.2",
    "rimraf": "^6.0.1",
    "simple-git-hooks": "^2.11.1",
    "tsup": "^8.3.5",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "unocss": "^0.65.3",
    "vitepress": "^1.5.0",
    "vitest": "^2.1.2"
  },
  "simple-git-hooks": {
    "pre-commit": "pnpm lint-staged"
  },
  "lint-staged": {
    "*": "eslint --fix"
  }
}
